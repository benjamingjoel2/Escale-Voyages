# Canonical site origin for metadata, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://escalevoyages.tourground.com

# Google Search Console HTML-tag verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity CMS. Leave the project ID empty to run on placeholder content.
# Create a project at https://www.sanity.io/manage, then add the site URL
# (and http://localhost:3000) under API → CORS origins.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Only needed for a private dataset.
SANITY_API_READ_TOKEN=

# Editor token with write access, used by `npm run seed` and (Phase 6) the forms.
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook that refreshes cached content.
SANITY_REVALIDATE_SECRET=

# Email (Resend). Without it, form emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Escale Voyages <escalevoyages@tourground.com>"

# Payments. With none set, the booking flow runs the mock adapter (test mode).
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENV=sandbox
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
