{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers deployment via the OpenNext adapter (@opennextjs/cloudflare).
	// Vercel ignores this file; "next build" is unchanged.
	"name": "escale-voyages",
	"main": "cloudflare/worker.mjs",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "escale-voyages"
		}
	],
	"kv_namespaces": [
		{
			// Incremental (ISR / "use cache") cache.
			"binding": "NEXT_INC_CACHE_KV",
			"id": "f4c32c9549f74fb9983616fef826c397"
		}
	],
	"durable_objects": {
		"bindings": [
			// Tag cache for revalidateTag (Sanity publish webhook).
			{ "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["DOShardedTagCache"] }
	],
	"images": {
		// Cloudflare Images binding used by next/image optimisation on Workers.
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
